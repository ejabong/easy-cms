# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
# Root domain used for tenant subdomain resolution (e.g. site-a.easycms.app)
ROOT_DOMAIN=localhost:3000

# ─── Database (PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL=postgresql://easycms:easycms@localhost:5432/easycms?schema=public

# ─── Redis (cache / rate limiting / queues) ─────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Better Auth ────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=replace-with-32+char-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Social providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ─── Email (transactional) ──────────────────────────────────────────────
EMAIL_FROM=no-reply@easycms.app
RESEND_API_KEY=

# ─── Storage (S3 / Cloudflare R2) ───────────────────────────────────────
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=easycms-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ─── Billing (Stripe) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ─── AI (Claude API) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-opus-4-8
