{
  "name": "easy-cms",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS website builder & headless CMS platform",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @easy-cms/web dev",
    "build": "pnpm --filter @easy-cms/web build",
    "start": "pnpm --filter @easy-cms/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @easy-cms/db generate",
    "db:migrate": "pnpm --filter @easy-cms/db migrate",
    "db:push": "pnpm --filter @easy-cms/db push",
    "db:seed": "pnpm --filter @easy-cms/db seed",
    "db:studio": "pnpm --filter @easy-cms/db studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
