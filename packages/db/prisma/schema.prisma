// ============================================================================
//  easy-cms — Multi-tenant Website Builder & CMS
//  Prisma schema (PostgreSQL)
//
//  Multi-tenancy model: shared database, row-level isolation.
//  Every tenant-owned row carries an `organizationId` and, where relevant,
//  a `siteId`. All queries MUST be scoped by these in the data-access layer.
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────
//  AUTH & IDENTITY  (Better Auth compatible)
// ──────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified Boolean   @default(false)
  // Platform-level role; site/org access is governed by Membership.
  platformRole  PlatformRole @default(USER)
  twoFactorEnabled Boolean @default(false)

  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  ownedOrgs     Organization[] @relation("OrgOwner")
  auditLogs     AuditLog[]
  comments      Comment[]
  posts         Post[]
  mediaUploads  Media[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId            String    // "credential" | "google" | "github" | "facebook"
  accountId             String    // provider account id
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   // hashed, for credential provider
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  // Active tenant context for the session (last selected org/site).
  activeOrganizationId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier])
}

enum PlatformRole {
  SUPER_ADMIN
  USER
}

// ──────────────────────────────────────────────────────────────────────────
//  TENANCY: ORGANIZATIONS, MEMBERSHIP, RBAC
// ──────────────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  ownerId   String
  owner     User     @relation("OrgOwner", fields: [ownerId], references: [id])

  members       Membership[]
  sites         Site[]
  subscription  Subscription?
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  invitations   Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role         @default(MEMBER)
  token          String       @unique
  status         InviteStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
}

enum Role {
  ADMIN   // org admin: manage users, billing, all sites
  EDITOR  // edit & publish content across sites
  AUTHOR  // create/edit own content, no publish
  MEMBER  // read-only / limited
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// ──────────────────────────────────────────────────────────────────────────
//  SITES, DOMAINS, THEMES
// ──────────────────────────────────────────────────────────────────────────

model Site {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  // System subdomain slug → {slug}.{ROOT_DOMAIN}
  slug        String       @unique
  description String?
  logo        String?
  favicon     String?
  status      SiteStatus   @default(DRAFT)

  // Branding / contact
  contactEmail String?
  contactPhone String?
  socialLinks  Json?       // { twitter, instagram, linkedin, ... }

  themeId     String?
  theme       Theme?       @relation(fields: [themeId], references: [id])
  templateId  String?
  template    Template?    @relation(fields: [templateId], references: [id])

  domains      Domain[]
  pages        Page[]
  collections  Collection[]
  posts        Post[]
  categories   Category[]
  tags         Tag[]
  media        Media[]
  mediaFolders MediaFolder[]
  forms        Form[]
  redirects    Redirect[]
  reusableBlocks ReusableBlock[]
  analyticsConfig AnalyticsConfig?

  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([organizationId])
  @@index([status])
}

enum SiteStatus {
  DRAFT
  STAGING
  PUBLISHED
  SUSPENDED
}

model Domain {
  id        String       @id @default(cuid())
  siteId    String
  site      Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  hostname  String       @unique // e.g. www.acme.com
  isPrimary Boolean      @default(false)
  status    DomainStatus @default(PENDING)
  // DNS verification
  verificationToken String?
  sslIssued Boolean      @default(false)
  createdAt DateTime     @default(now())
  verifiedAt DateTime?

  @@index([siteId])
}

enum DomainStatus {
  PENDING
  VERIFYING
  ACTIVE
  FAILED
}

model Theme {
  id        String   @id @default(cuid())
  // Null organizationId = global/system theme available to all tenants.
  organizationId String?
  name      String
  // Design tokens: colors, typography, spacing, radius, shadows, light/dark.
  tokens    Json
  isDefault Boolean  @default(false)
  sites     Site[]
  templates Template[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// ──────────────────────────────────────────────────────────────────────────
//  TEMPLATES (marketplace) + versioning
// ──────────────────────────────────────────────────────────────────────────

model Template {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  category    TemplateCategory
  thumbnail   String?
  // null = global marketplace template; set = org-private template.
  organizationId String?
  isPublished Boolean          @default(false)

  themeId     String?
  theme       Theme?           @relation(fields: [themeId], references: [id])

  versions    TemplateVersion[]
  sites       Site[]
  installs    Int              @default(0)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([category])
  @@index([organizationId])
}

model TemplateVersion {
  id         String   @id @default(cuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version    String   // semver
  // Snapshot of pages + theme + assets manifest.
  manifest   Json
  changelog  String?
  createdAt  DateTime @default(now())

  @@unique([templateId, version])
}

enum TemplateCategory {
  BUSINESS
  PORTFOLIO
  AGENCY
  RESTAURANT
  ECOMMERCE
  PERSONAL
  BLOG
  LANDING_PAGE
}

// ──────────────────────────────────────────────────────────────────────────
//  PAGES + BUILDER (block tree) + versioning
// ──────────────────────────────────────────────────────────────────────────

model Page {
  id        String     @id @default(cuid())
  siteId    String
  site      Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)

  title     String
  slug      String     // unique within a site
  type      PageType   @default(CUSTOM)
  status    ContentStatus @default(DRAFT)
  isHomePage Boolean   @default(false)

  // The live, rendered block tree (array of Section nodes). See builder docs.
  content   Json       @default("[]")

  // SEO (embedded; mirrors SeoMeta fields for the page)
  seo       Json?

  versions  PageVersion[]

  publishedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([siteId, slug])
  @@index([siteId, status])
}

model PageVersion {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version   Int
  content   Json
  label     String?  // e.g. "Autosave", "Manual save", "Published"
  authorId  String?
  createdAt DateTime @default(now())

  @@unique([pageId, version])
  @@index([pageId])
}

model ReusableBlock {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  // Block subtree JSON, droppable into any page.
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

enum PageType {
  HOME
  ABOUT
  CONTACT
  LANDING_PAGE
  BLOG
  CUSTOM
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// ──────────────────────────────────────────────────────────────────────────
//  HEADLESS CMS: collections, dynamic fields, records
// ──────────────────────────────────────────────────────────────────────────

model Collection {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  // Is this a built-in system collection (pages/posts) or user-defined?
  isSystem  Boolean  @default(false)
  fields    CollectionField[]
  records   Record[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, slug])
  @@index([siteId])
}

model CollectionField {
  id           String    @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  name         String
  key          String     // machine key used in record.data
  type         FieldType
  required     Boolean    @default(false)
  // For SELECT/MULTI_SELECT options, REFERENCE target collection, validation, etc.
  config       Json?
  order        Int        @default(0)

  @@unique([collectionId, key])
  @@index([collectionId])
}

model Record {
  id           String    @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  // Field values keyed by CollectionField.key
  data         Json
  status       ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([collectionId, status])
}

enum FieldType {
  TEXT
  TEXTAREA
  RICH_TEXT
  NUMBER
  BOOLEAN
  DATE
  IMAGE
  GALLERY
  JSON
  SELECT
  MULTI_SELECT
  REFERENCE
}

// ──────────────────────────────────────────────────────────────────────────
//  BLOG
// ──────────────────────────────────────────────────────────────────────────

model Post {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id])

  title       String
  slug        String
  excerpt     String?
  // Tiptap JSON document
  content     Json     @default("{}")
  coverImage  String?
  status      ContentStatus @default(DRAFT)
  isFeatured  Boolean  @default(false)

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  tags        TagsOnPosts[]

  seo         Json?
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([siteId, slug])
  @@index([siteId, status])
  @@index([categoryId])
}

model Category {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name   String
  slug   String
  posts  Post[]

  @@unique([siteId, slug])
}

model Tag {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name   String
  slug   String
  posts  TagsOnPosts[]

  @@unique([siteId, slug])
}

model TagsOnPosts {
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

// ──────────────────────────────────────────────────────────────────────────
//  MEDIA LIBRARY
// ──────────────────────────────────────────────────────────────────────────

model MediaFolder {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  parent    MediaFolder? @relation("FolderTree", fields: [parentId], references: [id])
  children  MediaFolder[] @relation("FolderTree")
  media     Media[]
  createdAt DateTime @default(now())

  @@index([siteId])
}

model Media {
  id         String    @id @default(cuid())
  siteId     String
  site       Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  folderId   String?
  folder     MediaFolder? @relation(fields: [folderId], references: [id])
  uploaderId String?
  uploader   User?     @relation(fields: [uploaderId], references: [id])

  filename   String
  mimeType   String
  size       Int       // bytes
  width      Int?
  height     Int?
  url        String    // public/CDN url
  storageKey String    // S3/R2 object key
  alt        String?
  type       MediaType

  createdAt  DateTime  @default(now())

  @@index([siteId, folderId])
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

// ──────────────────────────────────────────────────────────────────────────
//  FORMS & LEADS
// ──────────────────────────────────────────────────────────────────────────

model Form {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name        String
  fields      FormField[]
  submissions FormSubmission[]
  // Notification + integration config
  notifyEmails String[]
  webhookUrl   String?
  recaptcha    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([siteId])
}

model FormField {
  id       String        @id @default(cuid())
  formId   String
  form     Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  label    String
  key      String
  type     FormFieldType
  required Boolean        @default(false)
  options  Json?          // for select/radio/checkbox
  order    Int            @default(0)

  @@index([formId])
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  data      Json
  meta      Json?    // ip, userAgent, referrer
  isSpam    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([formId, createdAt])
}

enum FormFieldType {
  TEXT
  EMAIL
  PHONE
  TEXTAREA
  SELECT
  RADIO
  CHECKBOX
  DATE
  FILE
}

// ──────────────────────────────────────────────────────────────────────────
//  SEO
// ──────────────────────────────────────────────────────────────────────────

model Redirect {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  source    String   // path
  target    String   // path or url
  permanent Boolean  @default(true) // 301 vs 302
  createdAt DateTime @default(now())

  @@unique([siteId, source])
  @@index([siteId])
}

// ──────────────────────────────────────────────────────────────────────────
//  ANALYTICS
// ──────────────────────────────────────────────────────────────────────────

model AnalyticsConfig {
  id        String  @id @default(cuid())
  siteId    String  @unique
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  provider  String  @default("internal") // internal | google | plausible | posthog
  trackingId String?
  config    Json?
}

model PageView {
  id        String   @id @default(cuid())
  siteId    String
  path      String
  referrer  String?
  country   String?
  device    String?
  sessionId String?
  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
  @@index([siteId, path])
}

// ──────────────────────────────────────────────────────────────────────────
//  BILLING (Stripe)
// ──────────────────────────────────────────────────────────────────────────

model Plan {
  id            String   @id @default(cuid())
  name          String   @unique // Free, Starter, Professional, Agency
  stripePriceId String?  @unique
  priceMonthly  Int      @default(0) // cents
  // Usage limits
  maxSites      Int      @default(1)
  maxPages      Int      @default(10)
  storageMb     Int      @default(500)
  features      Json     // feature flags
  subscriptions Subscription[]
}

model Subscription {
  id                   String   @id @default(cuid())
  organizationId       String   @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan     @relation(fields: [planId], references: [id])
  stripeCustomerId     String?
  stripeSubscriptionId String?  @unique
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

// ──────────────────────────────────────────────────────────────────────────
//  API, WEBHOOKS, AUDIT, COLLABORATION
// ──────────────────────────────────────────────────────────────────────────

model ApiKey {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  hashedKey      String   @unique
  prefix         String   // first chars shown in UI
  scopes         String[]
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

model Webhook {
  id        String   @id @default(cuid())
  siteId    String
  url       String
  events    String[] // e.g. ["form.submitted", "post.published"]
  secret    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([siteId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String   // e.g. "site.published", "user.invited"
  entityType     String?
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  // Polymorphic target: page | post | record
  entityType String
  entityId   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  resolved  Boolean  @default(false)
  parentId  String?
  parent    Comment? @relation("CommentThread", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentThread")
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
}
